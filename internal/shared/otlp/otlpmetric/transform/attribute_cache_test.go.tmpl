func resetAttrCache() {
	attrCacheMu.Lock()
	defer attrCacheMu.Unlock()
	clear(attrCache)
	attrCacheLastClear = time.Time{}
}

func enableAttrCache(t testing.TB, size int) {
	t.Setenv("OTEL_GO_X_OTLP_ATTRIBUTE_CACHE_SIZE", strconv.Itoa(size))
	loadAttrCacheSize()
	resetAttrCache()
	t.Cleanup(func() {
		maxCachedAttributeSets.Store(0)
		resetAttrCache()
	})
}

// fakeAttrCacheClock replaces the cache clock and returns a function that advances it.
func fakeAttrCacheClock(t testing.TB) func(time.Duration) {
	now := time.Unix(0, 0)
	orig := attrCacheNow
	attrCacheNow = func() time.Time { return now }
	t.Cleanup(func() { attrCacheNow = orig })
	return func(d time.Duration) { now = now.Add(d) }
}

func fillAttrCache(from, to int) {
	for i := from; i < to; i++ {
		cachedAttrs(attribute.NewSet(attribute.Int("series", i)))
	}
}

func TestCachedAttrsMatchesAttrIter(t *testing.T) {
	enableAttrCache(t, 10)
	set := attribute.NewSet(
		attribute.String("env", "prod"),
		attribute.Int("n", 7),
		attribute.Bool("ok", true),
	)

	want := AttrIter(set.Iter())
	assert.Equal(t, want, cachedAttrs(set), "cache miss must equal AttrIter")
	assert.Equal(t, want, cachedAttrs(set), "cache hit must equal AttrIter")
}

func TestCachedAttrsHitReusesSlice(t *testing.T) {
	enableAttrCache(t, 10)
	set := attribute.NewSet(attribute.String("env", "prod"))

	first := cachedAttrs(set)
	second := cachedAttrs(set)
	require.NotEmpty(t, first)
	assert.Same(t, &first[0], &second[0], "cache hit must reuse the slice backing array")
}

func TestCachedAttrsEmptySet(t *testing.T) {
	enableAttrCache(t, 10)
	assert.Nil(t, cachedAttrs(*attribute.EmptySet()))
}

func TestCachedAttrsFull(t *testing.T) {
	const size = 100
	enableAttrCache(t, size)
	advance := fakeAttrCacheClock(t)

	fillAttrCache(0, size)
	require.Len(t, attrCache, size)

	// Within the interval, starting from the first overflow, a full cache keeps its
	// entries and skips new ones.
	set := attribute.NewSet(attribute.Int("series", size))
	assert.Equal(t, AttrIter(set.Iter()), cachedAttrs(set))
	advance(minAttrCacheClearInterval - time.Second)
	cachedAttrs(set)
	assert.Len(t, attrCache, size, "full cache should not clear within the interval")
	assert.NotContains(t, attrCache, set.Equivalent())

	// After the interval, the next overflow clears and stores the new entry.
	advance(time.Second)
	cachedAttrs(set)
	assert.Len(t, attrCache, 1, "full cache should clear after the interval")
	assert.Contains(t, attrCache, set.Equivalent())
}

func TestResourceMetricsReadsCacheSize(t *testing.T) {
	rm := &metricdata.ResourceMetrics{
		ScopeMetrics: []metricdata.ScopeMetrics{
			{
				Metrics: []metricdata.Metrics{
					{
						Name: "m",
						Data: metricdata.Gauge[int64]{
							DataPoints: []metricdata.DataPoint[int64]{
								{Attributes: attribute.NewSet(attribute.String("env", "prod"))},
							},
						},
					},
				},
			},
		},
	}
	t.Cleanup(func() {
		maxCachedAttributeSets.Store(0)
		resetAttrCache()
	})

	t.Setenv("OTEL_GO_X_OTLP_ATTRIBUTE_CACHE_SIZE", "10")
	_, err := ResourceMetrics(rm)
	require.NoError(t, err)
	assert.Len(t, attrCache, 1, "cache should be enabled by the environment variable")

	resetAttrCache()
	t.Setenv("OTEL_GO_X_OTLP_ATTRIBUTE_CACHE_SIZE", "0")
	_, err = ResourceMetrics(rm)
	require.NoError(t, err)
	assert.Empty(t, attrCache, "cache should be disabled by the environment variable")
}

func TestCachedAttrsDisabled(t *testing.T) {
	enableAttrCache(t, 0)

	set := attribute.NewSet(attribute.String("env", "prod"))
	assert.Equal(t, AttrIter(set.Iter()), cachedAttrs(set))
	assert.Empty(t, attrCache)
}

func TestCachedAttrsConcurrentSafe(t *testing.T) {
	enableAttrCache(t, 100)

	const n = 50
	var wg sync.WaitGroup
	for i := range n {
		wg.Go(func() {
			set := attribute.NewSet(attribute.Int("series", i))
			assert.Equal(t, AttrIter(set.Iter()), cachedAttrs(set))
		})
	}
	wg.Wait()
}
