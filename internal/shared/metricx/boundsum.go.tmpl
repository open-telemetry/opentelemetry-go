func (s *Store) point(attrs attribute.Set, mode pointMode) *point {
	distinct := attrs.Equivalent()
	if p, ok := s.active[distinct]; ok {
		if mode == boundPoint {
			p.bound.Store(true)
		}
		return p
	}

	concrete := len(s.active)
	if _, ok := s.active[overflowSet.Equivalent()]; ok {
		concrete--
	}
	if s.limit > 0 && concrete >= s.limit-1 {
		attrs = overflowSet
		distinct = attrs.Equivalent()
		if p, ok := s.active[distinct]; ok {
			if mode == boundPoint {
				p.bound.Store(true)
			}
			return p
		}
	}
	p := newPoint(attrs, s.filter, s.reservoir)
	p.bound.Store(mode == boundPoint)
	s.active[distinct] = p
	return p
}

