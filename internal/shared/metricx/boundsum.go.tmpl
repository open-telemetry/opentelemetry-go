func (p *point) snapshot(t time.Time, mode collectMode) metricdata.DataPoint[int64] {
	p.mu.RLock()
	defer p.mu.RUnlock()
	var value int64
	if mode == deltaCollect {
		value = p.value.Swap(0)
	} else {
		value = p.value.Load()
	}
	dp := metricdata.DataPoint[int64]{
		Attributes: p.attrs,
		StartTime:  p.start,
		Time:       t,
		Value:      value,
	}
	p.resMu.Lock()
	var ex []exemplar.Exemplar
	p.reservoir.Collect(&ex)
	for _, e := range ex {
		dp.Exemplars = append(dp.Exemplars, metricdata.Exemplar[int64]{
			FilteredAttributes: slices.Clone(e.FilteredAttributes),
			Time:               e.Time,
			Value:              e.Value.Int64(),
			SpanID:             slices.Clone(e.SpanID),
			TraceID:            slices.Clone(e.TraceID),
		})
	}
	if mode == deltaCollect {
		p.reservoir = p.newRes(p.attrs)
		p.start = t
	}
	p.resMu.Unlock()
	return dp
}

type pointMode uint8

